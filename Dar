                <h2>داشبۆردی بەکارهێنەر</h2>
                
                <div class="price-display">
                    <div class="price-card">
                        <h4>نرخی پاس</h4>
                        <div class="price-value" id="displayPassPrice">150000</div>
                    </div>
                    <div class="price-card">
                        <h4>نرخی فڕۆکە</h4>
                        <div class="price-value" id="displayAirplanePrice">350000</div>
                    </div>
                    <div class="price-card">
                        <h4>نرخی قیستی پاس</h4>
                        <div class="price-value" id="displayInstallmentPassPrice">180000</div>
                    </div>
                    <div class="price-card">
                        <h4>نرخی قیستی فڕۆکە</h4>
                        <div class="price-value" id="displayInstallmentAirplanePrice">400000</div>
                    </div>
                </div>
                
                <!-- Notice for installment -->
                <div class="notice" id="installmentNotice">
                    <h4>تێبینی</h4>
                    <p>ئەگەر قیستی پاس یان قیستی فڕۆکە دەتەوێ، پاسپۆرت و پارەکەت بهێنە بۆ کۆمپانیا</p>
                </div>
                
                <!-- Address -->
                <div class="address">
                    <h4>ناونیشان</h4>
                    <p>جادەی ئەلبان بەرامبەر یاریگای ١٦ی ئاب</p>
                </div>
                
                <div class="card">
                    <h3>داواکاری نوێ</h3>
                    <form class="booking-form" id="bookingForm">
                        <div class="form-control">
                            <label for="fullName">ناوی تەواو</label>
                            <input type="text" id="fullName" required>
                        </div>
                        <div class="form-control">
                            <label for="age">تەمەن</label>
                            <input type="number" id="age" required>
                        </div>
                        <div class="form-control">
                            <label for="bookingType">جۆری داواکاری</label>
                            <select id="bookingType" required>
                                <option value="pass">پاس</option>
                                <option value="airplane">فڕۆکە</option>
                                <option value="installment_pass">قیستی پاس</option>
                                <option value="installment_airplane">قیستی فڕۆکە</option>
                            </select>
                        </div>
                        <div class="form-control">
                            <label for="passport">پاسپۆرت</label>
                            <input type="file" id="passport" accept=".jpg,.jpeg,.png,.pdf">
                        </div>
                        <div class="form-control">
                            <label for="photo">وێنە</label>
                            <input type="file" id="photo" accept=".jpg,.jpeg,.png">
                        </div>
                        <div class="form-control full-width">
                            <button type="submit" class="submit-btn">ناردنی داواکاری</button>
                        </div>
                    </form>
                </div>
                
                <div class="card">
                    <h3>مێژووی داواکاریەکانم</h3>
                    <table class="requests-table">
                        <thead>
                            <tr>
                                <th>جۆری داواکاری</th>
                                <th>نرخ</th>
                                <th>کاتی داواکاری</th>
                                <th>دۆخی داواکاری</th>
                            </tr>
                        </thead>
                        <tbody id="userRequestsTableBody">
                            <!-- User requests will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>سیستم رزرواسیون سەفەر - 2023</p>
        </div>
    </footer>

