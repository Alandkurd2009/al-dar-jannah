        const languageSelect = document.getElementById('languageSelect');
        const userInfo = document.getElementById('userInfo');
        const loginBtn = document.getElementById('loginBtn');
        const registerBtn = document.getElementById('registerBtn');
        const updatePricesBtn = document.getElementById('updatePricesBtn');
        const bookingForm = document.getElementById('bookingForm');
        const requestsTableBody = document.getElementById('requestsTableBody');
        const userRequestsTableBody = document.getElementById('userRequestsTableBody');
        const installmentNotice = document.getElementById('installmentNotice');

        // Event listeners
        document.addEventListener('DOMContentLoaded', initializeApp);
        languageSelect.addEventListener('change', changeLanguage);
        loginBtn.addEventListener('click', login);
        registerBtn.addEventListener('click', register);
        document.getElementById('registerLink').addEventListener('click', showRegisterForm);
        document.getElementById('backToLoginLink').addEventListener('click', showLoginForm);
        updatePricesBtn.addEventListener('click', updatePrices);
        bookingForm.addEventListener('submit', submitBooking);

        // Initialize the application
        function initializeApp() {
            // Set initial language
            changeLanguage();
            
            // Check if user is already logged in (for demo purposes)
            // In a real app, you would check from localStorage or session
        }

        // Change language
        function changeLanguage() {
            currentLanguage = languageSelect.value;
            document.documentElement.lang = currentLanguage;
            document.documentElement.dir = currentLanguage === 'en' ? 'ltr' : 'rtl';
            
            // Update all text content based on selected language
            updateTextContent();
        }

        // Update all text content based on current language
        function updateTextContent() {
            const lang = translations[currentLanguage];
            
            // Login form
            document.getElementById('loginTitle').textContent = lang.loginTitle;
            document.getElementById('usernameLabel').textContent = lang.usernameLabel;
            document.getElementById('passwordLabel').textContent = lang.passwordLabel;
            document.getElementById('loginBtn').textContent = lang.loginBtn;
            document.getElementById('registerLink').textContent = lang.registerLink;
            
            // Registration form
            document.getElementById('registerTitle').textContent = lang.registerTitle;
            document.getElementById('regUsernameLabel').textContent = lang.regUsernameLabel;
            document.getElementById('regPasswordLabel').textContent = lang.regPasswordLabel;
            document.getElementById('registerBtn').textContent = lang.registerBtn;
            document.getElementById('backToLoginLink').textContent = lang.backToLoginLink;
            
            // Admin panel
            if (adminPanel.style.display !== 'none') {
                document.querySelector('#adminPanel h2').textContent = lang.adminDashboard;
                document.querySelector('.price-controls h3').textContent = lang.priceControls;
                document.querySelector('label[for="passPrice"]').textContent = lang.passPrice;
                document.querySelector('label[for="airplanePrice"]').textContent = lang.airplanePrice;
                document.querySelector('label[for="installmentPassPrice"]').textContent = lang.installmentPassPrice;
                document.querySelector('label[for="installmentAirplanePrice"]').textContent = lang.installmentAirplanePrice;
                document.getElementById('updatePricesBtn').textContent = lang.updatePricesBtn;
                document.querySelector('#adminPanel .card h3').textContent = lang.requests;
                
                // Update table headers
                const adminTableHeaders = document.querySelectorAll('#adminPanel .requests-table th');
                adminTableHeaders[0].textContent = lang.user;
                adminTableHeaders[1].textContent = lang.requestType;
                adminTableHeaders[2].textContent = lang.price;
                adminTableHeaders[3].textContent = lang.passport;
                adminTableHeaders[4].textContent = lang.photo;
                adminTableHeaders[5].textContent = lang.requestTime;
            }
            
            // User dashboard
            if (userDashboard.style.display !== 'none') {
                document.querySelector('#userDashboard h2').textContent = lang.userDashboard;
                document.querySelector('#userDashboard .card h3').textContent = lang.newRequest;
                document.querySelector('#userDashboard .card:last-child h3').textContent = lang.requestHistory;
                
                // Update form labels
                document.querySelector('label[for="fullName"]').textContent = lang.fullName;
                document.querySelector('label[for="age"]').textContent = lang.age;
                document.querySelector('label[for="bookingType"]').textContent = lang.bookingType;
                document.querySelector('label[for="passport"]').textContent = lang.passport;
                document.querySelector('label[for="photo"]').textContent = lang.photo;
                document.querySelector('.submit-btn').textContent = lang.submitRequest;
                
                // Update table headers
                const userTableHeaders = document.querySelectorAll('#userDashboard .requests-table th');
                userTableHeaders[0].textContent = lang.requestType;
                userTableHeaders[1].textContent = lang.price;
                userTableHeaders[2].textContent = lang.requestTime;
                userTableHeaders[3].textContent = lang.status;
                
                // Update notice and address
                document.querySelector('#installmentNotice h4').textContent = lang.noticeTitle;
                document.querySelector('#installmentNotice p').textContent = lang.noticeText;
                document.querySelector('.address h4').textContent = lang.addressTitle;
                document.querySelector('.address p').textContent = lang.addressText;
            }
            
            // Update user info if logged in
            if (currentUser) {
                updateUserInfo();
            }
        }

        // Show registration form
        function showRegisterForm(e) {
            e.preventDefault();
            loginContainer.style.display = 'none';
            registerContainer.style.display = 'flex';
        }

        // Show login form
        function showLoginForm(e) {
            e.preventDefault();
            registerContainer.style.display = 'none';
            loginContainer.style.display = 'flex';
        }

        // Login function
        function login() {
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            
            // Check if admin
            if (username === 'pshtiwan' && password === 'p6561414') {
                currentUser = username;
                isAdmin = true;
                showMainContent();
                return;
            }
            
            // Check if regular user (in a real app, you would check against a database)
            const users = JSON.parse(localStorage.getItem('users') || '[]');
            const user = users.find(u => u.username === username && u.password === password);
            
            if (user) {
                currentUser = username;
                isAdmin = false;
                showMainContent();
            } else {
                alert(currentLanguage === 'ku' ? 'ناوی بەکارهێنەر یان پاسۆرد هەڵەیە' : 
                      currentLanguage === 'ar' ? 'اسم المستخدم أو كلمة المرور غير صحيحة' :
                      'Username or password is incorrect');
            }
        }

        // Register function
        function register() {
            const username = document.getElementById('regUsername').value;
            const password = document.getElementById('regPassword').value;
            
            if (!username || !password) {
                alert(currentLanguage === 'ku' ? 'تکایە هەموو خانەکان پڕ بکەرەوە' : 
                      currentLanguage === 'ar' ? 'يرجى ملء جميع الحقول' :
                      'Please fill all fields');
                return;
            }
            
            // Save user to localStorage (in a real app, you would send to a server)
            const users = JSON.parse(localStorage.getItem('users') || '[]');
            
            // Check if username already exists
            if (users.find(u => u.username === username)) {
                alert(currentLanguage === 'ku' ? 'ئەم ناوی بەکارهێنەرە هەیە' : 
                      currentLanguage === 'ar' ? 'اسم المستخدم موجود بالفعل' :
                      'Username already exists');
                return;
            }
            
            users.push({ username, password });
            localStorage.setItem('users', JSON.stringify(users));
            
            alert(currentLanguage === 'ku' ? 'تۆمارکرا بە سەرکەوتویی' : 
                  currentLanguage === 'ar' ? 'تم التسجيل بنجاح' :
                  'Registered successfully');
            
            showLoginForm({ preventDefault: () => {} });
        }

        // Show main content after login
        function showMainContent() {
            loginContainer.style.display = 'none';
            registerContainer.style.display = 'none';
            mainContent.style.display = 'block';
            
            if (isAdmin) {
                adminPanel.style.display = 'block';
                userDashboard.style.display = 'none';
                loadAdminData();
            } else {
                adminPanel.style.display = 'none';
                userDashboard.style.display = 'block';
                loadUserData();
            }
            
            updateUserInfo();
            updateTextContent();
        }

        // Update user info in header
        function updateUserInfo() {
            const lang = translations[currentLanguage];
            userInfo.innerHTML = `
                <span>${currentUser}</span>
                <button class="logout-btn" id="logoutBtn">${lang.logout}</button>
            `;
            document.getElementById('logoutBtn').addEventListener('click', logout);
        }

        // Logout function
        function logout() {
            currentUser = null;
            isAdmin = false;
            mainContent.style.display = 'none';
            loginContainer.style.display = 'flex';
            document.getElementById('username').value = '';
            document.getElementById('password').value = '';
            userInfo.innerHTML = '';
        }

        // Load admin data
        function loadAdminData() {
            // Load prices from localStorage
            const savedPrices = JSON.parse(localStorage.getItem('prices'));
            if (savedPrices) {
                prices = savedPrices;
                document.getElementById('passPrice').value = prices.pass;
                document.getElementById('airplanePrice').value = prices.airplane;
                document.getElementById('installmentPassPrice').value = prices.installment_pass;
                document.getElementById('installmentAirplanePrice').value = prices.installment_airplane;
            }
            
            // Load requests from localStorage
            requests = JSON.parse(localStorage.getItem('requests') || '[]');
            updateRequestsTable();
        }

        // Load user data
        function loadUserData() {
            // Load prices from localStorage
            const savedPrices = JSON.parse(localStorage.getItem('prices'));
            if (savedPrices) {
                prices = savedPrices;
            }
            
            // Update price display
            document.getElementById('displayPassPrice').textContent = prices.pass;
            document.getElementById('displayAirplanePrice').textContent = prices.airplane;
            document.getElementById('displayInstallmentPassPrice').textContent = prices.installment_pass;
            document.getElementById('displayInstallmentAirplanePrice').textContent = prices.installment_airplane;
            
            // Load user requests
            requests = JSON.parse(localStorage.getItem('requests') || '[]');
            const userRequests = requests.filter(req => req.user === currentUser);
            updateUserRequestsTable(userRequests);
        }

        // Update prices
        function updatePrices() {
            prices.pass = parseInt(document.getElementById('passPrice').value);
            prices.airplane = parseInt(document.getElementById('airplanePrice').value);
            prices.installment_pass = parseInt(document.getElementById('installmentPassPrice').value);
            prices.installment_airplane = parseInt(document.getElementById('installmentAirplanePrice').value);
            
            // Save to localStorage
            localStorage.setItem('prices', JSON.stringify(prices));
            
            alert(currentLanguage === 'ku' ? 'نرخەکان نوێکرانەوە' : 
                  currentLanguage === 'ar' ? 'تم تحديث الأسعار' :
                  'Prices updated');
        }

        // Submit booking
        function submitBooking(e) {
            e.preventDefault();
            
            const fullName = document.getElementById('fullName').value;
            const age = document.getElementById('age').value;
            const bookingType = document.getElementById('bookingType').value;
            const passportFile = document.getElementById('passport').files[0];
            const photoFile = document.getElementById('photo').files[0];
            
            if (!fullName || !age || !bookingType) {
                alert(currentLanguage === 'ku' ? 'تکایە هەموو خانە پێویستەکان پڕ بکەرەوە' : 
                      currentLanguage === 'ar' ? 'يرجى ملء جميع الحقول المطلوبة' :
                      'Please fill all required fields');
                return;
            }
            
            // Create request object
            const request = {
                id: Date.now(),
                user: currentUser,
                fullName,
                age,
                type: bookingType,
                price: prices[bookingType],
                timestamp: new Date().toLocaleString(),
                status: 'Pending'
            };
            
            // Add to requests array
            requests.push(request);
            
            // Save to localStorage
            localStorage.setItem('requests', JSON.stringify(requests));
            
            // Update user requests table
            const userRequests = requests.filter(req => req.user === currentUser);
            updateUserRequestsTable(userRequests);
            
            // Reset form
            bookingForm.reset();
            
            alert(currentLanguage === 'ku' ? 'داواکاریەکەت نێردرا' : 
                  currentLanguage === 'ar' ? 'تم إرسال طلبك' :
                  'Your request has been submitted');
        }

        // Update requests table for admin
        function updateRequestsTable() {
            requestsTableBody.innerHTML = '';
            
            requests.forEach(request => {
                const row = document.createElement('tr');
                
                // Determine request type text based on language
                let typeText = '';
                if (currentLanguage === 'ku') {
                    typeText = request.type === 'pass' ? 'پاس' : 
                              request.type === 'airplane' ? 'فڕۆکە' :
                              request.type === 'installment_pass' ? 'قیستی پاس' : 'قیستی فڕۆکە';
                } else if (currentLanguage === 'ar') {
                    typeText = request.type === 'pass' ? 'باص' : 
                              request.type === 'airplane' ? 'طائرة' :
                              request.type === 'installment_pass' ? 'تقسيط باص' : 'تقسيط طائرة';
                } else {
                    typeText = request.type === 'pass' ? 'Pass' : 
                              request.type === 'airplane' ? 'Airplane' :
                              request.type === 'installment_pass' ? 'Installment Pass' : 'Installment Airplane';
                }
                
                row.innerHTML = `
                    <td>${request.user}</td>
                    <td>${typeText}</td>
                    <td>${request.price}</td>
                    <td>${request.passportFile ? '✓' : '✗'}</td>
                    <td>${request.photoFile ? '✓' : '✗'}</td>
                    <td>${request.timestamp}</td>
                `;
                
                requestsTableBody.appendChild(row);
            });
        }

        // Update user requests table
        function updateUserRequestsTable(userRequests) {
            userRequestsTableBody.innerHTML = '';
            
            userRequests.forEach(request => {
                const row = document.createElement('tr');
                
                // Determine request type text based on language
                let typeText = '';
                if (currentLanguage === 'ku') {
                    typeText = request.type === 'pass' ? 'پاس' : 
                              request.type === 'airplane' ? 'فڕۆکە' :
                              request.type === 'installment_pass' ? 'قیستی پاس' : 'قیستی فڕۆکە';
                } else if (currentLanguage === 'ar') {
                    typeText = request.type === 'pass' ? 'باص' : 
                              request.type === 'airplane' ? 'طائرة' :
                              request.type === 'installment_pass' ? 'تقسيط باص' : 'تقسيط طائرة';
                } else {
                    typeText = request.type === 'pass' ? 'Pass' : 
                              request.type === 'airplane' ? 'Airplane' :
                              request.type === 'installment_pass' ? 'Installment Pass' : 'Installment Airplane';
                }
                
                // Determine status text based on language
                let statusText = '';
                if (currentLanguage === 'ku') {
                    statusText = request.status === 'Pending' ? 'چاوەڕوان' : 
                                request.status === 'Approved' ? 'پەسەندکراو' : 'ڕەتکراوە';
                } else if (currentLanguage === 'ar') {
                    statusText = request.status === 'Pending' ? 'قيد الانتظار' : 
                                request.status === 'Approved' ? 'مقبول' : 'مرفوض';
                } else {
                    statusText = request.status;
                }
                
                row.innerHTML = `
                    <td>${typeText}</td>
                    <td>${request.price}</td>
                    <td>${request.timestamp}</td>
                    <td>${statusText}</td>
                `;
                
                userRequestsTableBody.appendChild(row);
            });
        }
    </script>
</body>
</html>
